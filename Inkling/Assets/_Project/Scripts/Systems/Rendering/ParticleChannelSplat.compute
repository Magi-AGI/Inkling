// Compute-to-texture intermediate for particle-authoritative rendering.
// Reads the iparticle StructuredBuffer and writes the render-visible ink channels into 3 RGBA float
// render textures. `ifloat` defaults to FLOAT in the committed mode, so the default iparticle stride is
// 60 bytes / 15 fields (11 real ink channels 0..10 after Metal + 4 color overrides).
//
// This avoids a stride mismatch: CGPROGRAM fragment shaders on desktop promote half → float and would
// expect a 60-byte iparticle; a transient half build would be 30 bytes. Compute shaders read the buffer
// layout correctly, so we splat here and let the fragment shader sample standard float textures.
// M0: this splat still packs the same channels; _Channels2.w stays reserved until M1 wires true-metal rendering.

#pragma kernel ChannelSplat

#include "Packages/com.inktools.core/Compute/InkToolsTypes.hlsl"
#include "Packages/com.inktools.core/ScriptsAndShaders/iparticle.cs"

StructuredBuffer<iparticle> _ParticlesRead;

// Heat is a SEPARATE scalar simulation layer (ctx.Heat ping-pong RT), not an iparticle field.
// It is sampled here purely to pack into _Channels2.z for debug visualization (CP2). Read-only.
Texture2D<float> _HeatRead;

// Channel packing:
//   _Channels0: fire, water, plantSeeded, plantGrown
//   _Channels1: steam, glitter, blackBody, ice
//   _Channels2: electricitySeeded, electricityGrown, heat, reserved
RWTexture2D<float4> _Channels0;
RWTexture2D<float4> _Channels1;
RWTexture2D<float4> _Channels2;

int _Resolution;

[numthreads(8, 8, 1)]
void ChannelSplat(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Resolution || (int)id.y >= _Resolution)
        return;

    uint idx = id.y * (uint)_Resolution + id.x;
    iparticle p = _ParticlesRead[idx];

    float heat = _HeatRead[int2(id.xy)];

    _Channels0[int2(id.xy)] = float4((float)p.fire, (float)p.water, (float)p.plantSeeded, (float)p.plantGrown);
    _Channels1[int2(id.xy)] = float4((float)p.steam, (float)p.glitter, (float)p.blackBody, (float)p.ice);
    _Channels2[int2(id.xy)] = float4((float)p.electricitySeeded, (float)p.electricityGrown, heat, 0);
}
