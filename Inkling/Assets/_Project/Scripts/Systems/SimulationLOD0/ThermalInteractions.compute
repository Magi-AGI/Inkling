// ThermalInteractions.compute
// Heat-driven LOCAL phase changes, fully DATA-DRIVEN (CP7d slice 2).
//
// The rules are no longer hardcoded. FluidSolver bakes every active AffinityGroup's authored
// thermal data (falling back to the CP7 defaults) into ONE ordered rule set via ThermalRuleBaker,
// uploads it as two StructuredBuffers, and dispatches this kernel ONCE globally — heat is a single
// scalar field, so a per-group dispatch would break snapshot/cold/hot phase coherence.
//
// Execution model (must match ThermalCpuOracle exactly):
//     emission -> all COLD transitions in baked order -> all HOT transitions in baked order -> clamp
//
// Every conversion is per-cell only: a cell's own inks driven by its own heat. There is NO neighbour
// sampling and NO adjacency product, so a transition can never mint mass — each one is a paired
// from-- / to++. Only heat (energy, not mass) is consumed/released.
//
// The ckpt-024 hazard fix (newly-boiled steam must not condense in the same pass) is now EMERGENT
// rather than a special case: cold runs before hot, so at cold time nothing has produced steam yet.
// It is further guaranteed structurally — a hot transition's heat-budget cap (conv <= excess/heatCost)
// means heat_after >= its own threshold, and the baker's ladder rule keeps every cold threshold <=
// every hot threshold, so heat can never fall back into the condense band within a pass.
//
// Heat is a separate scalar layer whose RT STORAGE is RHalf (16-bit). The shader element types do NOT
// need to match that: it is read as an SRV (Texture2D<float>) and written via an RWTexture2D<ifloat> UAV
// where ifloat defaults to float (D2); Unity's SRV/UAV format conversion bridges float <-> the RHalf
// storage. Mirrors the sim's Heat kernels.

#pragma kernel ThermalInteractions

#include "Packages/com.inktools.core/Compute/InkToolsTypes.hlsl"
#include "Packages/com.inktools.core/ScriptsAndShaders/iparticle.cs"

// Must match GpuThermalTransition / GpuThermalSource in ThermalRuleBaker.cs field-for-field.
// Explicitly padded to 16-byte multiples (32 and 16 bytes) rather than relying on a fragile stride.
struct GpuThermalTransition
{
    int fromField;      // absolute iparticle field index (0..9)
    int toField;        // absolute iparticle field index (0..9), or -1 = SINK (CP8k): the source ink is
                        // REMOVED outright, with no destination credited. This is how cold fire goes out
                        // without minting smoke or a puddle. A sink only ever destroys ink, never creates
                        // it, so the no-minting invariant still holds.
    int regime;         // 0 = Cold, 1 = Hot
    int pad0;
    float threshold;
    float rate;
    float heatCost;     // HOT:  consumed per unit converted; also caps conversion to excess/heatCost
                        // COLD: heat REMOVED per unit converted (CP8g), a one-shot cooling event at
                        //       formation. Does NOT cap the conversion — cold has no heat budget to
                        //       spend, it is the thing producing the cold.
    float heatRelease;  // COLD: released per unit converted (latent heat)
};

struct GpuThermalSource
{
    int field;                // absolute iparticle field index (0..9)
    float heatEmissionRate;   // raw heat per unit of this ink per second
    float fuelCost;           // ink burned per unit of heat ACTUALLY added (0 = add-only)
    int pad0;
};

StructuredBuffer<iparticle> _ParticlesRead;
RWStructuredBuffer<iparticle> _ParticlesWrite;

Texture2D<float> _HeatRead;      // scalar heat layer (read-only SRV)
RWTexture2D<ifloat> _HeatWrite;  // scalar heat layer (UAV). D2: ifloat defaults to float; the RHalf RT's
                                 // 16-bit storage is bridged by the UAV format conversion, so the shader
                                 // element type does NOT need to equal the RT's half format.

StructuredBuffer<GpuThermalTransition> _ThermalTransitions;
StructuredBuffer<GpuThermalSource> _ThermalSources;
int _ThermalTransitionCount;
int _ThermalSourceCount;
int _ThermalRulesValid;   // 0 => the baked set was rejected; pass through inert (never partially apply)

int _Resolution;
float _FrameDeltaTime;
int _EnableThermalInteractions;
int _EnableHeatSources;

// Clamp bounds (ambient <= maxHeat, sanitized C#-side).
// CP8a: the clamp FLOOR is the absolute minimum temperature, NOT the neutral/room temperature.
// (Pre-CP8a this was `_AmbientTemperature`, which doubled as the heat-transport relaxation target.
// Using neutral as the floor would make room temperature the coldest attainable state — ice could
// never form. Neutral lives on in the InkTools transport kernels; only the clamp moved here.)
float _MinTemperature;
float _MaxHeat;

#define REGIME_COLD 0
#define REGIME_HOT  1

// Field-index accessors over the 10 ink channels (mirrors InkInteractions.compute).
float GetInkByIndex(iparticle p, int idx)
{
    switch (idx)
    {
        case 0: return p.fire;
        case 1: return p.water;
        case 2: return p.plantSeeded;
        case 3: return p.plantGrown;
        case 4: return p.steam;
        case 5: return p.glitter;
        case 6: return p.blackBody;
        case 7: return p.electricitySeeded;
        case 8: return p.electricityGrown;
        case 9: return p.ice;
        default: return 0;
    }
}

void SetInkByIndex(inout iparticle p, int idx, float value)
{
    switch (idx)
    {
        case 0: p.fire = value; break;
        case 1: p.water = value; break;
        case 2: p.plantSeeded = value; break;
        case 3: p.plantGrown = value; break;
        case 4: p.steam = value; break;
        case 5: p.glitter = value; break;
        case 6: p.blackBody = value; break;
        case 7: p.electricitySeeded = value; break;
        case 8: p.electricityGrown = value; break;
        case 9: p.ice = value; break;
    }
}

[numthreads(8, 8, 1)]
void ThermalInteractions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution || id.y >= (uint)_Resolution)
        return;

    uint idx = id.y * (uint)_Resolution + id.x;

    iparticle p = _ParticlesRead[idx];
    float heat = _HeatRead[int2(id.xy)];

    // Disabled OR an invalid/rejected rule set => EXACT pass-through of every field + heat.
    // An invalid set is inert, never partially applied.
    if (_EnableThermalInteractions == 0 || _ThermalRulesValid == 0)
    {
        _ParticlesWrite[idx] = p;
        _HeatWrite[int2(id.xy)] = heat;
        return;
    }

    float dt = _FrameDeltaTime;
    const float EPS = 1e-6;

    // 0. Emission. Energy is never minted: heat is added only up to the remaining headroom AND only
    //    as much as the local fuel supports, and the source is burned in proportion to the heat
    //    ACTUALLY added (never the raw emission). fuelCost == 0 => add-only, source untouched.
    //    The source is clamped >= 0 first so an upstream underflow can't emit negative heat or, via
    //    a negative burn term, inflate the ink.
    if (_EnableHeatSources != 0)
    {
        for (int s = 0; s < _ThermalSourceCount; s++)
        {
            GpuThermalSource src = _ThermalSources[s];

            float fuel = max(0.0, GetInkByIndex(p, src.field));
            float rawEmission = fuel * src.heatEmissionRate * dt;
            float headroom = max(0.0, _MaxHeat - heat);
            float heatAdded;

            if (src.fuelCost > EPS)
            {
                heatAdded = min(rawEmission, min(headroom, fuel / src.fuelCost));
                SetInkByIndex(p, src.field, max(0.0, fuel - heatAdded * src.fuelCost));
            }
            else
            {
                heatAdded = min(rawEmission, headroom);
                SetInkByIndex(p, src.field, fuel);   // no burn, but still clamp an underflow to 0
            }

            // rawEmission/headroom/fuel-cap are all >= 0, so heatAdded >= 0: heat never decreases here.
            heat += heatAdded;
        }
    }

    // 1. COLD transitions, in baked order. Gated by heat < threshold, rate-limited, may RELEASE heat.
    //    Cold runs before hot, so nothing has produced steam yet => the "condense from steam0" hazard
    //    fix falls out of the ordering.
    for (int c = 0; c < _ThermalTransitionCount; c++)
    {
        GpuThermalTransition t = _ThermalTransitions[c];
        if (t.regime != REGIME_COLD) continue;
        if (heat >= t.threshold) continue;

        // Clamp the source FIRST (as the emission path does). An upstream underflow (from < 0) would
        // otherwise yield conv < 0, which drains the DESTINATION ink and inverts the heat release.
        float from = max(0.0, GetInkByIndex(p, t.fromField));
        float conv = min(from, from * t.rate * dt);

        SetInkByIndex(p, t.fromField, max(0.0, from - conv));

        // CP8k: toField < 0 is the SINK sentinel — the ink is REMOVED, not converted, so there is no
        // destination to credit. This is how cold fire simply goes out without minting smoke or water.
        // A sink only ever destroys ink, so the no-minting invariant still holds (strictly, it is now
        // an inequality rather than an equality).
        if (t.toField >= 0)
            SetInkByIndex(p, t.toField, max(0.0, GetInkByIndex(p, t.toField) + conv));

        // CP8g: a cold transition applies BOTH terms as a signed net, scaled by how much actually
        // converted. heatCost is the ONE-SHOT cooling of forming the destination material (water->ice
        // chills the cell as the ice forms); heatRelease is latent heat given back. Because `from` is
        // clamped above, conv >= 0, so heatCost can only ever COOL — an underflowed source cannot
        // invert this into heating. Only cells that actually convert are cooled, which is exactly why
        // this is a formation event and not a continuous emitter: no conversion => conv == 0 => no
        // cooling, so a cell of settled ice with no water left to freeze stops pulling heat down.
        // Clamp BOTH ends: cold heatCost can now drive heat DOWN, so a min-clamp is required here and
        // not only in the final pass clamp — otherwise a large cost could push heat below the floor and
        // a later transition in this same loop would read that out-of-range value.
        heat = clamp(heat + conv * t.heatRelease - conv * t.heatCost, _MinTemperature, _MaxHeat);
    }

    // 2. HOT transitions, in baked order. Each re-derives its excess against its OWN threshold from
    //    the RUNNING heat (after prior drawdown), and is additionally capped by excess / heatCost.
    for (int h = 0; h < _ThermalTransitionCount; h++)
    {
        GpuThermalTransition t = _ThermalTransitions[h];
        if (t.regime != REGIME_HOT) continue;

        // Clamp the source FIRST. With from < 0 the conv would go negative, which not only drains the
        // destination ink but INVERTS the heat budget: `heat -= conv * heatCost` would ADD heat,
        // minting energy from a numerical underflow. Clamping makes conv == 0 and zeroes the source.
        float excess = max(0.0, heat - t.threshold);
        float from = max(0.0, GetInkByIndex(p, t.fromField));
        float conv = min(from, min(from * t.rate * dt, excess / max(t.heatCost, EPS)));

        SetInkByIndex(p, t.fromField, max(0.0, from - conv));

        // CP8k SINK sentinel (see the cold loop). Supported here too for symmetry, so a hot sink is
        // expressible without a second code path — the shipped rules only use a cold one (fire).
        if (t.toField >= 0)
            SetInkByIndex(p, t.toField, max(0.0, GetInkByIndex(p, t.toField) + conv));

        heat -= conv * t.heatCost;
    }

    heat = clamp(heat, _MinTemperature, _MaxHeat);

    _ParticlesWrite[idx] = p;
    _HeatWrite[int2(id.xy)] = heat;
}
