// InkInteractions.compute
// Matrix-kernel cellular automata for ink reactions.
// Runs after advection, before display.
//
// Determinism: Always sample neighbors from Read buffer; apply deltas once
// to Write at the end. Avoids race conditions.

#pragma kernel InkInteractions
#pragma kernel ApplyReactionImpulse

// Include iparticle struct definition (X-macro file)
#define ifloat float
#include "Packages/com.inktools.core/ScriptsAndShaders/iparticle.cs"

// Ink type indices come from _InkIndices at runtime (set by AffinityGroup).
// No HLSL defines needed - C# InkTypeId enum is the source of truth.

// Buffers
StructuredBuffer<iparticle> _ParticlesRead;
RWStructuredBuffer<iparticle> _ParticlesWrite;

// Simulation parameters
int _Resolution;
float _DeltaTime;
int _DebugMode;  // 0=normal, 1=test mode (boost fire when plant present)

// Black body ink clearing parameters
float _BlackBodyThreshold;    // Activation threshold (default 0.5)
float _BlackBodyClearingRate; // Rate at which other inks are cleared (default 0.05)
int _EnableBlackBodyClearing; // Toggle for black body clearing (0=off, 1=on)

// Affinity group data (MVP: single group, hardcoded thermal)
// Future: StructuredBuffer<GPUAffinityGroup> _AffinityGroups; int _NumGroups;
int4 _InkIndices;       // Which iparticle fields map to slots 0-3
float4x4 _ProductMatrix;   // Product reactions columns 0-3: 0×1, 0×2, 0×3, 1×2
float4 _ProductCol4;       // Product reactions column 4: 1×3
float4 _ProductCol5;       // Product reactions column 5: 2×3
float3 _Weights;        // self, cardinal, diagonal
float _RateMultiplier;  // Global multiplier for reaction rates (default ~10 for visible effects)
float4 _InteractionThresholds;  // Per-ink minimum concentration for reactions (matches _InkIndices order)

// CP8r: EVAPORATIVE COOLING for the Fire+Water contact quench.
//
// Lake: "when plant catches fire, and we try to douse the flames with water, it's never enough to
// completely cancel out the fire." Root cause: this pass removed fire MASS but never touched HEAT, so a
// doused cell stayed pinned near max temperature — above plantIgnitionThreshold (0.75), which kept
// regenerating Fire from Plant, and above fireSinkThreshold (0.6), so surviving fire never guttered out.
// Water depleted while plant kept re-lighting it.
//
// Vaporising water absorbs latent heat — that is physically HOW water extinguishes fire — so the quench
// now removes energy in proportion to how much Fire+Water actually converted.
//
// SCOPING: the host uploads a NON-ZERO cooling value ONLY for the affinity group whose pair-0x1 column is
// the Fire->Water->Steam quench. Every other group gets 0 and therefore passes heat through untouched.
// That keeps OrganicGroup's Fire x Plant burn (and every other pair column) from accidentally chilling
// the world. _QuenchCoolingPerUnit == 0 makes this whole block a pass-through.
float _QuenchCoolingPerUnit;
Texture2D<float> _HeatRead;      // scalar heat layer (read-only SRV)
RWTexture2D<ifloat> _HeatWrite;  // scalar heat layer (UAV; ifloat == half matches RHalf)
float _MinTemperature;
float _MaxHeat;

// ── Reaction-driven motion (data-driven, generalized) ────────────────────────
// The concentration reaction path (productMatrix) does not move fluid. To let reactions
// push the field (e.g. fire spreading out of a still plant region), each affinity group
// carries a parallel "reaction impulse matrix" with the SAME 6 pair columns as the product
// matrix. Convention, for a pair column A×B:
//   * DIRECTION = grad(slotB) - grad(slotA)  — the local concentration-gradient front normal
//                 pointing from A toward B (the fuel the reaction advances into).
//   * INTENSITY = column-sum of the impulse matrix for that pair (signed) × the reaction
//                 product magnitude. For "A + B -> C" put a positive coefficient in row C;
//                 a negative coefficient flips the vector direction.
// This is independent from the concentration productMatrix, so motion strength tunes
// separately from conversion speed. Nothing here hardcodes specific ink types.
//
// InkInteractions accumulates a per-cell VECTOR (RG) = sum over pairs of normalize(dir) *
// intensity. ApplyReactionImpulse later converts that vector into bounded velocity. Gather /
// per-cell writes only (one thread owns one cell), so no scatter/atomics are needed.
int _AccumulateReactionImpulse;   // 0/1: whether InkInteractions writes into _ReactionImpulseRW
float _ReactionImpulseGain;       // scales the accumulated vector before impulse conversion
float4x4 _ReactionImpulseMatrix;  // impulse coefficients, columns 0-3: 0×1, 0×2, 0×3, 1×2
float4 _ReactionImpulseCol4;      // impulse coefficients column 4: 1×3
float4 _ReactionImpulseCol5;      // impulse coefficients column 5: 2×3
RWTexture2D<float2> _ReactionImpulseRW;  // accumulated reaction impulse vector (cleared each step)

// ApplyReactionImpulse params
Texture2D<float2> _ReactionImpulseRead;  // reaction impulse vector field (SRV view of the RW target)
Texture2D<float2> _VelocityReadRI;
RWTexture2D<float2> _VelocityWriteRI;
float _ReactionImpulseStrength;   // velocity delta per unit magnitude (per-step; dt-scaled below)
float _ReactionImpulseMax;        // clamp on per-cell velocity delta magnitude
float _ReactionImpulseCurlBias;   // weight of tangential (swirl) component
float _ReactionImpulseExpansionBias;  // weight of outward front-normal component
float _ReactionImpulseDtScale;    // FrameDeltaTime/Timestep: matches other per-substep velocity impulses

// Helper: Extract ink value by field index (0-9)
float GetInkByIndex(iparticle p, int idx)
{
    switch (idx)
    {
        case 0: return p.fire;
        case 1: return p.water;
        case 2: return p.plantSeeded;
        case 3: return p.plantGrown;
        case 4: return p.steam;
        case 5: return p.glitter;
        case 6: return p.blackBody;
        case 7: return p.electricitySeeded;
        case 8: return p.electricityGrown;
        case 9: return p.ice;
        default: return 0;
    }
}

// Helper: Set ink value by field index (0-9)
void SetInkByIndex(inout iparticle p, int idx, float value)
{
    switch (idx)
    {
        case 0: p.fire = value; break;
        case 1: p.water = value; break;
        case 2: p.plantSeeded = value; break;
        case 3: p.plantGrown = value; break;
        case 4: p.steam = value; break;
        case 5: p.glitter = value; break;
        case 6: p.blackBody = value; break;
        case 7: p.electricitySeeded = value; break;
        case 8: p.electricityGrown = value; break;
        case 9: p.ice = value; break;
    }
}

// Helper: Extract 4 inks for this group
float4 ExtractGroupInks(iparticle p, int4 indices)
{
    return float4(
        GetInkByIndex(p, indices.x),
        GetInkByIndex(p, indices.y),
        GetInkByIndex(p, indices.z),
        GetInkByIndex(p, indices.w)
    );
}

// Helper: Sample particle at position (clamped to bounds)
iparticle SampleParticle(int2 pos)
{
    pos = clamp(pos, int2(0, 0), int2(_Resolution - 1, _Resolution - 1));
    return _ParticlesRead[pos.y * _Resolution + pos.x];
}

// Reaction-impulse contribution for one A×B pair: normalized (gradB - gradA) direction times
// the signed (coef * saturated-product) intensity. gradX/gradY hold the per-slot central-
// difference gradients (index a/b are compile-time constants at every call site so the vector
// component access folds to a constant). A soft saturation prod/(1+prod) bounds each pair's
// contribution so raw (possibly large) product terms can't inject an unbounded impulse.
float2 ReactionPairVec(int a, int b, float prod, float coef, float4 gradX, float4 gradY)
{
    float2 dir = float2(gradX[b] - gradX[a], gradY[b] - gradY[a]);
    float len = length(dir);
    if (len < 1e-6 || abs(coef) < 1e-8 || prod <= 0.0)
        return float2(0.0, 0.0);
    float intensity = coef * (prod / (1.0 + prod));
    return (dir / len) * intensity;
}

// Applies ONE pair-reaction column as a single stoichiometric event, scaled by a common factor so
// production and consumption stay paired. This is the conservation fix (ckpt-015): a balanced
// (zero column-sum) reaction stays locally mass-conserving even when the pair PRODUCT is nonzero
// only because neighbors (adjacency) hold the reactants — consumption is limited by LOCAL
// availability, so a cell with no local reactant runs the event at scale 0 (no minting).
//   coeff               : per-output-slot stoichiometric coefficients for this pair column
//   extent              : raw reaction extent (thresholded product * dt * rate), >= 0
//   remaining           : local reactant budget (consumption draws it down)      [inout]
//   productionRemaining : shared per-step production budget per slot (draws down) [inout]
// Returns the (scaled) event delta to accumulate. Only NEGATIVE terms draw remaining; only
// POSITIVE terms draw the production budget — matching the requested convention. `appliedScale`
// (0..1) is the common factor the event was limited by, so callers (e.g. the reaction-impulse
// path) can gate motion on whether the concentration reaction actually occurred.
float4 ApplyLimitedReactionEvent(float4 coeff, float extent, inout float4 remaining, inout float4 productionRemaining, out float appliedScale)
{
    float4 eventDelta = coeff * extent;
    float scale = 1.0;

    [unroll]
    for (int i = 0; i < 4; i++)
    {
        if (eventDelta[i] < 0.0)
        {
            // Consuming slot i: cannot take more than is locally available.
            float avail = max(remaining[i], 0.0);
            scale = min(scale, avail / max(-eventDelta[i], 1e-8));
        }
        else if (eventDelta[i] > 0.0)
        {
            // Producing slot i: bounded by the shared per-step production budget.
            float budget = max(productionRemaining[i], 0.0);
            scale = min(scale, budget / max(eventDelta[i], 1e-8));
        }
    }

    appliedScale = saturate(scale);
    eventDelta *= appliedScale;

    [unroll]
    for (int j = 0; j < 4; j++)
    {
        remaining[j] += min(eventDelta[j], 0.0);            // negative consumption reduces remaining
        productionRemaining[j] -= max(eventDelta[j], 0.0);  // positive production reduces budget
    }

    return eventDelta;
}

[numthreads(8, 8, 1)]
void InkInteractions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution || id.y >= (uint)_Resolution)
        return;

    uint idx = id.y * _Resolution + id.x;
    int2 pos = int2(id.xy);

    // Read current particle (from Read buffer)
    iparticle p = _ParticlesRead[idx];

    // Debug mode: simple hardcoded test to verify shader is running
    if (_DebugMode == 1)
    {
        // If plant > 0.1, convert some to fire (very obvious effect)
        if (p.plantSeeded > 0.1)
        {
            p.fire = saturate(p.fire + 0.1);
            p.plantSeeded = saturate(p.plantSeeded - 0.05);
        }
        _ParticlesWrite[idx] = p;
        return;
    }

    // Sample self
    float4 selfInks = ExtractGroupInks(p, _InkIndices);

    // Sample cardinal neighbors (up, down, left, right). Kept individually (not just summed)
    // so per-slot concentration gradients are available for the reaction-impulse direction.
    float4 gUp    = ExtractGroupInks(SampleParticle(pos + int2(0, 1)), _InkIndices);
    float4 gDown  = ExtractGroupInks(SampleParticle(pos + int2(0, -1)), _InkIndices);
    float4 gRight = ExtractGroupInks(SampleParticle(pos + int2(1, 0)), _InkIndices);
    float4 gLeft  = ExtractGroupInks(SampleParticle(pos + int2(-1, 0)), _InkIndices);
    float4 cardinalSum = gUp + gDown + gRight + gLeft;

    // Sample diagonal neighbors (corners)
    float4 diagonalSum = float4(0, 0, 0, 0);
    diagonalSum += ExtractGroupInks(SampleParticle(pos + int2(1, 1)), _InkIndices);
    diagonalSum += ExtractGroupInks(SampleParticle(pos + int2(1, -1)), _InkIndices);
    diagonalSum += ExtractGroupInks(SampleParticle(pos + int2(-1, 1)), _InkIndices);
    diagonalSum += ExtractGroupInks(SampleParticle(pos + int2(-1, -1)), _InkIndices);

    // Weighted adjacency
    float4 adjacency = selfInks * _Weights.x
                     + cardinalSum * _Weights.y
                     + diagonalSum * _Weights.z;

    // Compute pairwise products for conjunctive reactions (A + B → C)
    // For 4 inks (0,1,2,3), there are 6 pairwise products:
    // products0: 0×1, 0×2, 0×3, 1×2  (columns 0-3 of product matrix)
    // products1: 1×3, 2×3            (columns 4-5, stored in _ProductCol4/5)
    float4 products0 = float4(
        adjacency.x * adjacency.y,  // 0×1 (e.g., fire×water → steam)
        adjacency.x * adjacency.z,  // 0×2
        adjacency.x * adjacency.w,  // 0×3 (e.g., fire×ice → water)
        adjacency.y * adjacency.z   // 1×2
    );
    float2 products1 = float2(
        adjacency.y * adjacency.w,  // 1×3
        adjacency.z * adjacency.w   // 2×3
    );

    // Threshold gating per product term (both reactants must exceed their thresholds)
    float t01 = max(_InteractionThresholds.x, _InteractionThresholds.y);
    float t02 = max(_InteractionThresholds.x, _InteractionThresholds.z);
    float t03 = max(_InteractionThresholds.x, _InteractionThresholds.w);
    float t12 = max(_InteractionThresholds.y, _InteractionThresholds.z);
    float t13 = max(_InteractionThresholds.y, _InteractionThresholds.w);
    float t23 = max(_InteractionThresholds.z, _InteractionThresholds.w);

    if (adjacency.x < t01 || adjacency.y < t01) products0.x = 0;
    if (adjacency.x < t02 || adjacency.z < t02) products0.y = 0;
    if (adjacency.x < t03 || adjacency.w < t03) products0.z = 0;
    if (adjacency.y < t12 || adjacency.z < t12) products0.w = 0;
    if (adjacency.y < t13 || adjacency.w < t13) products1.x = 0;
    if (adjacency.z < t23 || adjacency.w < t23) products1.y = 0;

    // ----- Event-level conservation (ckpt-015) -----
    // Apply each pair column as ONE stoichiometric event scaled by a single factor. This replaces
    // the old (mul → per-channel ClampConsumption → independent positive clamp) path, which could
    // MINT mass at reaction fronts: the product uses neighborhood adjacency, but consumption was
    // clipped per-channel against LOCAL selfInks, so a cell with no local reactant kept the
    // positive production while zeroing the negative terms (e.g. Fire+Ice→Water in an empty cell).
    // Here, consumption is limited by local availability and production by a shared per-step budget,
    // both by scaling the WHOLE event — so balanced (zero column-sum) reactions stay conservative
    // and negative-only sink columns still remove up to local availability without ever creating.
    float dtRate = _DeltaTime * _RateMultiplier;

    // Per-pair column coefficient vectors (same convention as mul(_ProductMatrix, products0):
    // column k of the matrix = per-output-slot coefficients for pair k).
    float4 col01 = mul(_ProductMatrix, float4(1, 0, 0, 0)); // pair 0×1
    float4 col02 = mul(_ProductMatrix, float4(0, 1, 0, 0)); // pair 0×2
    float4 col03 = mul(_ProductMatrix, float4(0, 0, 1, 0)); // pair 0×3
    float4 col12 = mul(_ProductMatrix, float4(0, 0, 0, 1)); // pair 1×2
    float4 col13 = _ProductCol4;                            // pair 1×3
    float4 col23 = _ProductCol5;                            // pair 2×3

    const float MAX_PRODUCTION_PER_STEP = 0.8;
    float4 remaining = max(selfInks, 0.0);                  // local reactant budget (consumption)
    float4 productionRemaining = float4(MAX_PRODUCTION_PER_STEP, MAX_PRODUCTION_PER_STEP,
                                        MAX_PRODUCTION_PER_STEP, MAX_PRODUCTION_PER_STEP);

    // Accumulate six limited pair events in a deterministic fixed order. Capture each event's
    // applied scale (0..1) so the reaction-impulse path can respect the same conservation limit.
    float4 delta = float4(0, 0, 0, 0);
    float s01, s02, s03, s12, s13, s23;
    // CP8r: keep the pair-0x1 event delta, not just its accumulation — the cooling amount is derived
    // from the STEAM this column actually produced (see below), which is stricter than a raw product.
    float4 event01 = ApplyLimitedReactionEvent(col01, products0.x * dtRate, remaining, productionRemaining, s01);
    delta += event01;
    delta += ApplyLimitedReactionEvent(col02, products0.y * dtRate, remaining, productionRemaining, s02);
    delta += ApplyLimitedReactionEvent(col03, products0.z * dtRate, remaining, productionRemaining, s03);
    delta += ApplyLimitedReactionEvent(col12, products0.w * dtRate, remaining, productionRemaining, s12);
    delta += ApplyLimitedReactionEvent(col13, products1.x * dtRate, remaining, productionRemaining, s13);
    delta += ApplyLimitedReactionEvent(col23, products1.y * dtRate, remaining, productionRemaining, s23);

    // CP8r: evaporative cooling from the Fire+Water quench.
    //
    // Keyed off the pair-0x1 column's APPLIED OUTPUT (see below), not raw adjacency — s01 is the
    // conservation scale ApplyLimitedReactionEvent actually used, so if the event was limited to zero by
    // local availability or the production budget, no heat is removed. Cooling therefore cannot fire when
    // no quench happened, which is the invariant that keeps this honest.
    //
    // Heat is only WRITTEN here, never added to, and is clamped to [_MinTemperature, _MaxHeat] — so this
    // can only ever remove energy and cannot mint it. Every cell writes back (pass-through when cooling is
    // 0 or nothing converted), so the heat layer stays complete for the next group/pass.
    if (_QuenchCoolingPerUnit > 0.0)
    {
        // CKPT-103 hardening: derive the amount from the STEAM this pair column actually PRODUCED
        // (event01.z, slot 2), not from the raw pair product. `products0.x * dtRate * s01` was only
        // correct because the host scopes cooling to the quench group; this makes the guarantee
        // intrinsic. A column that produces no steam — a zero col01, or any non-quench column — now
        // yields zero cooling even if the host were mis-scoped. Defense in depth: the host scope gate
        // (Fire/Water/Steam slots + consuming col0 producing Steam) still applies on top.
        //
        // event01 is already conservation-limited, so this IS the applied amount, not a request.
        float appliedQuench = max(0.0, event01.z);
        float heat = _HeatRead[int2(id.xy)];
        heat = clamp(heat - _QuenchCoolingPerUnit * appliedQuench, _MinTemperature, _MaxHeat);
        _HeatWrite[int2(id.xy)] = heat;
    }

    // Apply deltas back to particle
    iparticle result = p;

    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int fieldIdx = _InkIndices[i];
        float currentVal = GetInkByIndex(result, fieldIdx);
        float newVal = max(0.0, currentVal + delta[i]);  // Clamp to non-negative
        SetInkByIndex(result, fieldIdx, newVal);
    }

    // ----- Reaction impulse accumulation (data-driven vector) -----
    // For each of the 6 conjunctive pair products, add a vector = normalize(gradB - gradA) *
    // (columnSumOfImpulseMatrix * saturated-product). Direction comes from the concentration
    // gradient of THIS group's slots (no ink names hardcoded); the impulse matrix column-sum
    // is the signed intensity (positive row C => A+B->C pushes toward B; negative flips it).
    //
    // CONSERVATION NOTE (ckpt-016): the impulse intensity now uses products * the SAME per-pair
    // event scale (s01..s23) that limited the concentration reaction, so motion is only generated
    // where a real (limited) reaction occurred — a cell that could not pay for a reaction locally
    // (scale 0) contributes no impulse, instead of the old raw-adjacency "non-event" motion.
    // dt NOTE: products0/products1 are the raw adjacency products (post-threshold) and the scales
    // are dimensionless, so the impulse still carries no dt here; its single dt factor remains
    // _ReactionImpulseDtScale (subDt/timestep) in ApplyReactionImpulse — there is no dt^2.
    if (_AccumulateReactionImpulse != 0)
    {
        // Per-slot central-difference gradients from the cardinal neighbors.
        float4 gradX = 0.5 * (gRight - gLeft);
        float4 gradY = 0.5 * (gUp - gDown);

        // Column sums of the impulse matrix: mul(ones, M)[k] = sum over rows of column k.
        // (Same row=output-slot / column=pair convention as _ProductMatrix.)
        float4 impCoef0 = mul(float4(1, 1, 1, 1), _ReactionImpulseMatrix);  // pairs 0×1,0×2,0×3,1×2
        float impCoef4 = dot(_ReactionImpulseCol4, float4(1, 1, 1, 1));     // pair 1×3
        float impCoef5 = dot(_ReactionImpulseCol5, float4(1, 1, 1, 1));     // pair 2×3

        // products * event scale: motion respects the conservation limiting of each reaction.
        float2 acc = float2(0.0, 0.0);
        acc += ReactionPairVec(0, 1, products0.x * s01, impCoef0.x, gradX, gradY);
        acc += ReactionPairVec(0, 2, products0.y * s02, impCoef0.y, gradX, gradY);
        acc += ReactionPairVec(0, 3, products0.z * s03, impCoef0.z, gradX, gradY);
        acc += ReactionPairVec(1, 2, products0.w * s12, impCoef0.w, gradX, gradY);
        acc += ReactionPairVec(1, 3, products1.x * s13, impCoef4, gradX, gradY);
        acc += ReactionPairVec(2, 3, products1.y * s23, impCoef5, gradX, gradY);

        acc *= _ReactionImpulseGain;
        // Additive across the per-group dispatches of this step (each dispatch has this
        // thread own exactly this cell; dispatches are sequential, so += is race-free).
        _ReactionImpulseRW[int2(id.xy)] = _ReactionImpulseRW[int2(id.xy)] + acc;
    }

    // ----- Black Body Ink Clearing -----
    // When black body concentration exceeds threshold, it actively clears all other inks.
    // Reference behavior: bb > 0.5 triggers -0.05 per tick drain on all 9 other ink types.
    if (_EnableBlackBodyClearing > 0 && result.blackBody > _BlackBodyThreshold)
    {
        float clearAmount = _BlackBodyClearingRate;

        // Clear all other ink types (indices 0-5, 7-9; skip 6 which is blackBody itself)
        result.fire = max(0.0, result.fire - clearAmount);
        result.water = max(0.0, result.water - clearAmount);
        result.plantSeeded = max(0.0, result.plantSeeded - clearAmount);
        result.plantGrown = max(0.0, result.plantGrown - clearAmount);
        result.steam = max(0.0, result.steam - clearAmount);
        result.glitter = max(0.0, result.glitter - clearAmount);
        result.electricitySeeded = max(0.0, result.electricitySeeded - clearAmount);
        result.electricityGrown = max(0.0, result.electricityGrown - clearAmount);
        result.ice = max(0.0, result.ice - clearAmount);
    }

    // Write to output buffer
    _ParticlesWrite[idx] = result;
}

// Converts the accumulated reaction-impulse VECTOR field into a bounded velocity impulse.
// Runs after pressure projection + obstacle boundary (so it isn't immediately cancelled)
// and before vorticity confinement (so swirl can amplify it).
//
// The accumulator already stores a direction (the reaction front normal) and magnitude
// (intensity), so no ink types or concentration re-sampling are needed here. To let a thin
// reacting front also move the cells immediately adjacent to it, each cell adopts the vector
// of the strongest neighbor in its 3x3 (neighborhood max BY MAGNITUDE — carries both the
// amplitude and the direction outward from the front). That vector's normal drives a
// curl-biased + weaker-expansion impulse, dt-scaled to match the pipeline's other per-substep
// velocity impulses, and clamped to avoid a reaction->fuel->faster-reaction runaway.
[numthreads(8, 8, 1)]
void ApplyReactionImpulse(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution || id.y >= (uint)_Resolution)
        return;

    int2 p = int2(id.xy);
    int hi = _Resolution - 1;

    // Neighborhood max by magnitude: adopt the strongest nearby reaction vector.
    float2 best = float2(0.0, 0.0);
    float bestMag = 0.0;
    [unroll]
    for (int oy = -1; oy <= 1; oy++)
    {
        [unroll]
        for (int ox = -1; ox <= 1; ox++)
        {
            int2 s = int2(clamp(p.x + ox, 0, hi), clamp(p.y + oy, 0, hi));
            float2 v = _ReactionImpulseRead[s];
            float m = length(v);
            if (m > bestMag) { bestMag = m; best = v; }
        }
    }

    float2 vel = _VelocityReadRI[p];

    if (bestMag > 1e-6)
    {
        float2 n = best / bestMag;              // front normal (expansion direction)
        float2 tangential = float2(-n.y, n.x);  // consistent-handed swirl around the front

        float2 dir = _ReactionImpulseCurlBias * tangential
                   + _ReactionImpulseExpansionBias * n;

        // dt scaling: magnitude ~ strength * amp * (subDt/timestep) so injected energy is
        // framerate/substep independent, matching vorticity confinement / force injection.
        float2 impulse = dir * (bestMag * _ReactionImpulseStrength * _ReactionImpulseDtScale);

        float mag = length(impulse);
        if (mag > _ReactionImpulseMax)
            impulse *= _ReactionImpulseMax / mag;

        vel += impulse;
    }

    _VelocityWriteRI[p] = vel;
}
