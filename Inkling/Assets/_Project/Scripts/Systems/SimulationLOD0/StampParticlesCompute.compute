// GPU particle stamping for TexturedInjector.
// Mirrors StampDensityCompute.compute but writes into
// RWStructuredBuffer<iparticle> instead of density RenderTextures.
// Stamps occur before AdvectParticles in ProcessPendingOperations,
// so sequential dispatch ordering provides an implicit barrier.
//
// Color Palette Lookup: Each ink type has a "key color" defined in InkTypeDef.
// Stamp pixel colors are matched against these key colors to determine which
// ink channel(s) to write to. This allows arbitrary texture colors to map to
// any ink type based on artist-defined palettes.
//
// Future: Reverse gradient lookup could sample gradients backwards to find
// the ink type whose gradient produces the closest output color.

#pragma kernel StampParticles

#include "Packages/com.inktools.core/Compute/InkToolsTypes.hlsl"
#include "Packages/com.inktools.core/ScriptsAndShaders/iparticle.cs"

RWStructuredBuffer<iparticle> _ParticlesRW;
Texture2D<float4>   _StampTex;
SamplerState         sampler_StampTex;

float2 _StampCenter;       // UV centre (0-1)
float2 _StampSize;         // UV extent (stampWidth/resolution, stampHeight/resolution)
float  _AlphaThreshold;
float  _DensityMul;
float  _UseOverride;
float4 _OverrideColor;
float2 _Resolution;

// Color palette for ink type matching (Count ink slots, RGB + tolerance in .w)
// Index matches InkTypeId enum: 0=Fire, 1=Water, 2=PlantSeeded, 3=PlantGrown,
// 4=Steam, 5=Glitter, 6=BlackBody, 7=ElectricitySeeded, 8=ElectricityGrown, 9=Ice, 10=Metal
// M0: array is Count-sized (11) for index-10 safety; Metal has NO authored key color yet, so its slot
// carries tolerance 0 (never matches) — the real Metal key color arrives with the Metal asset in M1.
float4 _InkKeyColors[11];     // RGB in xyz, tolerance in w (index 0..10)
int _NumActiveInks;           // How many inks have valid key colors (Count = 11)
int _UsePaletteLookup;        // 1 = use palette matching, 0 = legacy RGB mapping

// Helper: Calculate RGB distance between two colors (ignoring alpha)
float ColorDistance(float3 a, float3 b)
{
    float3 diff = a - b;
    return sqrt(dot(diff, diff));
}

// Helper: Add ink amount to the appropriate channel by index
void AddInkByIndex(inout iparticle p, int inkIdx, float amount)
{
    switch (inkIdx)
    {
        case 0: p.fire += (ifloat)amount; break;
        case 1: p.water += (ifloat)amount; break;
        case 2: p.plantSeeded += (ifloat)amount; break;
        case 3: p.plantGrown += (ifloat)amount; break;
        case 4: p.steam += (ifloat)amount; break;
        case 5: p.glitter += (ifloat)amount; break;
        case 6: p.blackBody += (ifloat)amount; break;
        case 7: p.electricitySeeded += (ifloat)amount; break;
        case 8: p.electricityGrown += (ifloat)amount; break;
        case 9: p.ice += (ifloat)amount; break;
        case 10: p.metal += (ifloat)amount; break;
    }
}

[numthreads(8, 8, 1)]
void StampParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution.x || id.y >= (uint)_Resolution.y)
        return;

    float2 uv = (float2(id.xy) + 0.5) / _Resolution;
    float2 rel = (uv - _StampCenter) / _StampSize + 0.5;

    // Outside stamp region — skip
    if (rel.x < 0.0 || rel.x > 1.0 || rel.y < 0.0 || rel.y > 1.0)
        return;

    float4 stamp = _StampTex.SampleLevel(sampler_StampTex, rel, 0);
    if (stamp.a < _AlphaThreshold)
        return;

    float4 color;
    float3 matchColor;

    // Separate palette matching hue from injected amount.
    // Multiplying RGB by _DensityMul was pushing values >1, causing no palette entry
    // to fall within tolerance when density multipliers are high (e.g., 5).
    if (_UseOverride > 0.5)
    {
        matchColor = _OverrideColor.rgb;                 // use artist override hue
        color = float4(_OverrideColor.rgb * stamp.a,     // premultiply by alpha for write
                       stamp.a);                         // preserve original amount
    }
    else
    {
        matchColor = stamp.rgb;                          // sampled texture hue (unscaled)
        color = float4(stamp.rgb * _DensityMul,          // scale amount only
                       stamp.a   * _DensityMul);
    }

    uint idx = id.y * (uint)_Resolution.x + id.x;
    iparticle p = _ParticlesRW[idx];

    if (_UsePaletteLookup > 0)
    {
        // Color Palette Lookup: find best matching ink type
        float bestDist = 1e10;
        int bestInk = -1;
        float3 inputColor = matchColor;

        for (int i = 0; i < _NumActiveInks; i++)
        {
            float3 keyColor = _InkKeyColors[i].xyz;
            float tolerance = _InkKeyColors[i].w;
            // Inactive slot: tolerance <= 0 means "no authored key color" (e.g. M0 Metal, index 10). Skip so
            // an EXACT color hit cannot select it — otherwise dist=0 would pass `dist <= tolerance*1.732`
            // (0 <= 0) and wrongly write that channel. Real key colors always carry a positive tolerance.
            if (tolerance <= 0.0)
                continue;
            float dist = ColorDistance(inputColor, keyColor);

            if (dist < bestDist && dist <= tolerance * 1.732) // 1.732 = sqrt(3) for max RGB distance
            {
                bestDist = dist;
                bestInk = i;
            }
        }

        // If we found a match, add ink to that channel
        if (bestInk >= 0)
        {
            AddInkByIndex(p, bestInk, color.a);
        }
    }
    else
    {
        // Legacy mode: direct RGB -> fire/water/ice mapping
        p.fire  += (ifloat)color.r;
        p.water += (ifloat)color.g;
        p.ice   += (ifloat)color.b;
    }

    _ParticlesRW[idx] = p;
}
